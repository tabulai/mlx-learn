{
  "script": "\"\"\"Validate updated production BF16 dispatch against frozen v2 and FP64 oracle.\"\"\"\nfrom pathlib import Path\nimport hashlib,json,time\nimport numpy as np\nimport mlx.core as mx\nfrom gap_baseline import production as old\nfrom mlxlearn._kernels import e_means_bf16 as new\nrng=np.random.default_rng(409)\nresult={'script':Path(__file__).read_text(),'old_source_sha256':hashlib.sha256(Path(old.__file__).read_bytes()).hexdigest(),'new_source_sha256':hashlib.sha256(Path(new.__file__).read_bytes()).hexdigest(),'correctness':[],'timing':[]}\noutput=Path('benchmarks/e_means/results/gap_investigation/production-validation.json')\nfor n,k,d in [(1,1,96),(7,3,128),(33,65,96),(67,129,128),(131,257,128),(65,71,100),(35,65,1024)]:\n x=mx.array(rng.standard_normal((n,d),dtype=np.float32)).astype(mx.bfloat16)\n c,norms=new.prepare_centers(mx.array(rng.standard_normal((k,d),dtype=np.float32)))\n xn=np.asarray(x.astype(mx.float32)).astype(np.float64);cn=np.asarray(c.astype(mx.float32)).astype(np.float64)\n for spherical in [False,True]:\n  labels,scores=new.assign_bf16(x,c,norms=norms,batch_size=17,spherical=spherical)\n  oldlabels,oldscores=old.assign_bf16(x,c,norms=norms,batch_size=17,spherical=spherical)\n  values=-(xn@cn.T) if spherical else np.sum(cn*cn,axis=1)-2*(xn@cn.T)\n  expected=values.argmin(axis=1)\n  np.testing.assert_array_equal(np.asarray(labels),expected)\n  np.testing.assert_array_equal(np.asarray(labels),np.asarray(oldlabels))\n  np.testing.assert_allclose(np.asarray(scores),values[np.arange(n),expected],rtol=3e-6,atol=3e-4)\n  result['correctness'].append({'n':n,'k':k,'d':d,'spherical':spherical,'oracle_label_mismatches':0,'frozen_label_mismatches':0,'maximum_score_difference':float(np.max(abs(np.asarray(scores)-np.asarray(oldscores))))})\nfor d in [96,128]:\n x=mx.full((11,d),100000,mx.float32)\n c=mx.full((131,d),100000,mx.float32)\n labels,scores=new.assign_bf16(x,c)\n np.testing.assert_array_equal(np.asarray(labels),np.zeros(11,np.uint32))\n assert np.isfinite(np.asarray(scores)).all()\nresult['duplicate_ties_beyond_fp16_range_pass']=True\nfor d,n,k in [(96,32768,16384),(128,32768,16384),(96,8192,8192),(128,8192,8192),(100,8192,16384),(1024,8192,16384)]:\n x=mx.array(rng.standard_normal((n,d),dtype=np.float32)/np.sqrt(d)).astype(mx.bfloat16)\n c,norms=new.prepare_centers(mx.array(rng.standard_normal((k,d),dtype=np.float32)/np.sqrt(d)));mx.eval(x,c,norms)\n methods=[('old',lambda:old.assign_bf16(x,c,norms=norms)),('new',lambda:new.assign_bf16(x,c,norms=norms))]\n for name,fun in methods:\n  mx.eval(fun());started=time.perf_counter()\n  while time.perf_counter()-started<.08:mx.eval(fun())\n record={'n':n,'k':k,'d':d,'old_seconds':[],'new_seconds':[]}\n outputs={}\n for r in range(5):\n  for name,fun in methods if r%2==0 else methods[::-1]:\n   for repeat in range(7):\n    started=time.perf_counter();out=fun();mx.eval(out);mx.synchronize();record[name+'_seconds'].append(time.perf_counter()-started)\n   outputs[name]=out\n np.testing.assert_array_equal(np.asarray(outputs['new'][0]),np.asarray(outputs['old'][0]))\n record['all_label_mismatches']=0\n record['speedup']=float(np.median(record['old_seconds'])/np.median(record['new_seconds']))\n result['timing'].append(record);output.write_text(json.dumps(result,indent=2)+'\\n')\n print(d,n,k,'speedup',round(record['speedup'],4),'old_ms',round(np.median(record['old_seconds'])*1000,4),'new_ms',round(np.median(record['new_seconds'])*1000,4),flush=True)\nprint('correctness passed',len(result['correctness']),flush=True)\n",
