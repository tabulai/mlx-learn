  "driver_source": "from pathlib import Path\nimport hashlib,json,os,random,shutil,subprocess,tempfile,zipfile,statistics\nrepo=Path('/Users/tunguz/Programming/mlxlearn')\nwork=Path(tempfile.mkdtemp(prefix='mlxlearn-startup-package-'))\nlazy=work/'lazy'; eager=work/'eager'\nshutil.copytree(repo/'src',lazy,ignore=shutil.ignore_patterns('__pycache__','*.pyc'))\nshutil.copytree(lazy,eager)\nwith zipfile.ZipFile(repo/'benchmarks/reference/knn-latency-final-2026-10-30.zip') as zf:\n for relative in ['mlxlearn/__init__.py','mlxlearn/_common/__init__.py']:\n  names=[n for n in zf.namelist() if n.endswith(relative)]\n  assert len(names)==1,names\n  (eager/relative).write_bytes(zf.read(names[0]))\ndef inventory(root):\n return {str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(root.rglob('*')) if p.is_file()}\ninv={label:inventory(path) for label,path in [('lazy',lazy),('eager',eager)]}\ndiff=[p for p in sorted(set(inv['lazy'])|set(inv['eager'])) if inv['lazy'].get(p)!=inv['eager'].get(p)]\nassert diff==['mlxlearn/__init__.py','mlxlearn/_common/__init__.py'],diff\nnative={p:sha for p,sha in inv['lazy'].items() if '_neighbors_cpu_native' in p and p.endswith('.so')}\nassert native\nworker=r'''\nimport sys,time,json\nstart=time.perf_counter()\nimport numpy as np\nif sys.argv[1]=='nn':\n from mlxlearn.neighbors import NearestNeighbors as Estimator\nelse:\n from mlxlearn.neighbors import KNeighborsClassifier as Estimator\nloaded=time.perf_counter()\nrng=np.random.default_rng(718)\nX=rng.standard_normal((8192,8) if sys.argv[1]=='nn' else (398,30)).astype(np.float32)\nQ=X[:1].copy() if sys.argv[1]=='nn' else X[:32].copy()\ny=np.arange(len(X))%3\nprepared=time.perf_counter()\nmodel=Estimator(n_neighbors=5)\nt=time.perf_counter()\nmodel.fit(X) if sys.argv[1]=='nn' else model.fit(X,y)\nfit=time.perf_counter()-t\nt=time.perf_counter()\nmodel.kneighbors(Q) if sys.argv[1]=='nn' else model.predict(Q)\nquery=time.perf_counter()-t\nend=time.perf_counter()\nprint(json.dumps(dict(import_ms=(loaded-start)*1000,data_ms=(prepared-loaded)*1000,fit_ms=fit*1000,query_ms=query*1000,import_fit_query_ms=(loaded-start+fit+query)*1000,full_ms=(end-start)*1000,mlx_loaded='mlx.core' in sys.modules)))\n'''\nrows=[];rng=random.Random(8921)\nfor case,count in [('nn',11),('classifier',7)]:\n for repeat in range(count):\n  labels=['lazy','eager'];rng.shuffle(labels)\n  for label in labels:\n   env=os.environ.copy();env['PYTHONPATH']=str(work/label)\n   row=json.loads(subprocess.check_output(['python3','-c',worker,case],cwd=work,env=env,text=True))\n   row.update(case=case,repeat=repeat,mode=label);rows.append(row)\nresult=dict(driver_source=Path(__file__).read_text(),work=str(work),differing_files=diff,native_binary_hashes=native,inventories=inv,rows=rows)\npath=Path('/Users/tunguz/Programming/mlxlearn/benchmarks/results/knn-startup-2026-10-30-package-comparison.json');path.write_text(json.dumps(result,indent=2))\nfor case in ('nn','classifier'):\n for label in ('lazy','eager'):\n  group=[r for r in rows if r['case']==case and r['mode']==label]\n  print(case,label,{key:statistics.median(r[key] for r in group) for key in ('import_ms','fit_ms','query_ms','import_fit_query_ms','full_ms')})\n print('paired total improvements ms',[round(next(r['import_fit_query_ms'] for r in rows if r['case']==case and r['repeat']==i and r['mode']=='eager')-next(r['import_fit_query_ms'] for r in rows if r['case']==case and r['repeat']==i and r['mode']=='lazy'),3) for i in range(11 if case=='nn' else 7)])\nprint(path)\nprint(work)\n",
